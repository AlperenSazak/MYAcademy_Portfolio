@model MYAcademy_Portfolio.Entities.About
@using MYAcademy_Portfolio.Entities
@{
    var hero = ViewBag.Hero as HeroSection;
    var activeProjectCount = ViewBag.ActiveProjectCount as int? ?? 0;
    var imageUrl = string.IsNullOrWhiteSpace(Model?.ImageUrl)
        ? Url.Content("~/images/WhatsApp Image 2026-04-19 at 12.26.54.jpeg")
        : Model!.ImageUrl;
    var title = Model?.Title ?? "Teknolojiye Tutkuyla Bağlı Bir Yolculuk.";
    var description = Model?.Description ?? "";
    var displayName = hero?.Greeting ?? "Alperen Sazak";
    var badge = hero?.Title ?? "Yazılım Geliştiricisi";
    var years = string.IsNullOrWhiteSpace(hero?.ExperienceYear) ? "2+" : hero!.ExperienceYear;
}
<section id="about" class="bg-white border-top border-bottom">
    <div class="container">
        <div class="row align-items-center gy-5">
            <div class="col-lg-5 reveal-on-scroll">
                <div class="about-img-wrap">
                    <img src="@imageUrl" alt="@displayName portre" class="w-100" style="height: 540px; object-fit: cover; object-position: center top;">
                    <div class="p-3 bg-light border-top d-flex align-items-center justify-content-between">
                        <span class="small text-muted font-heading">@displayName</span>
                        <span class="badge bg-secondary-subtle text-dark fw-medium">@badge</span>
                    </div>
                </div>
            </div>

            <div class="col-lg-7 ps-lg-5 reveal-on-scroll">
                <div class="eyebrow-badge">
                    <i class="bi bi-person-lines-fill"></i> BENİ TANIYIN
                </div>
                <h2 class="section-title">
                    @title
                </h2>
                <div class="text-muted fs-5 mb-4 lh-base">
                    @foreach (var paragraph in description.Split(new[] { "\r\n\r\n", "\n\n" }, StringSplitOptions.RemoveEmptyEntries))
                    {
                        <p class="mb-3">@paragraph</p>
                    }
                </div>

                <div class="row g-4 pt-2 pb-4 border-top border-bottom mb-4">
                    <div class="col-4">
                        <div class="stat-number">@years</div>
                        <div class="stat-label">Yıl Deneyim</div>
                    </div>
                    <div class="col-4">
                        <div class="stat-number">@(activeProjectCount > 0 ? $"{activeProjectCount}+" : "0")</div>
                        <div class="stat-label">Proje</div>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <a href="~/images/Alperen-Sazak-CV.pdf" download="Alperen Sazak_Ozgecmis.pdf" class="btn-sage">
                        <i class="bi bi-file-earmark-pdf"></i>
                        <span>Özgeçmişimi İndir</span>
                    </a>
                    <a href="#contact" class="btn-secondary-custom">
                        <span>Bana Ulaşın</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
