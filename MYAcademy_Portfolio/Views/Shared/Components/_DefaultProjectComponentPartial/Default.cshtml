@model List<MYAcademy_Portfolio.Entities.Project>
@using MYAcademy_Portfolio.Entities
@{
    var categories = ViewBag.Categories as List<Category> ?? new List<Category>();
}
<section id="projects">
    <div class="container">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-4 gap-3 reveal-on-scroll">
            <div>
                <div class="eyebrow-badge">
                    <i class="bi bi-folder-check"></i> SEÇİLMİŞ ÇALIŞMALAR
                </div>
                <h2 class="section-title mb-1">
                    Fikirden Ürüne Dönüşen Projeler
                </h2>
                <p class="section-description mb-0">
                    Öğrenme, üretme ve problem çözme süreçlerimin birer yansıması olan projelerimden bazıları.
                </p>
            </div>

            <div class="d-flex flex-wrap gap-2" id="projectFilters">
                <button class="filter-btn active" data-filter="all" type="button">Tümü</button>
                @foreach (var cat in categories)
                {
                    <button class="filter-btn" data-filter="@cat.CategoryName" type="button">@cat.CategoryName</button>
                }
            </div>
        </div>

        <div class="row g-4" id="projectGrid">
            @if (Model != null)
            {
                foreach (var item in Model)
                {
                    var filterKey = item.Category?.CategoryName ?? "all";
                    var image = string.IsNullOrWhiteSpace(item.ImageUrl)
                        ? "https://placehold.co/800x450?text=Proje"
                        : item.ImageUrl;
                    <div class="col-lg-6 project-item reveal-on-scroll" data-category="@filterKey">
                        <div class="project-card">
                            <div class="project-thumb-wrap">
                                <img src="@image" alt="@item.ProjectTitle" class="project-thumb-img">
                                <span class="project-category-tag">@(item.Category?.CategoryName ?? "Proje")</span>
                            </div>
                            <div class="project-body">
                                <h3 class="h4 fw-bold mb-2">@item.ProjectTitle</h3>
                                <p class="text-muted small mb-4 flex-grow-1">@item.Description</p>
                                <div class="mb-4">
                                    @if (!string.IsNullOrWhiteSpace(item.Technologies))
                                    {
                                        foreach (var tech in item.Technologies.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                                        {
                                            <span class="tech-badge">@tech</span>
                                        }
                                    }
                                </div>
                                <div class="d-flex align-items-center justify-content-between pt-3 border-top">
                                    <a href="#contact" class="btn-sage btn-sm">
                                        <span>Projeyi İncele</span>
                                        <i class="bi bi-arrow-up-right"></i>
                                    </a>
                                    <span class="text-muted small"><i class="bi bi-calendar3 me-1"></i>@item.CreatedDate.ToString("MMM yyyy")</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>

        <div class="text-center mt-5">
            <a href="#contact" class="btn-secondary-custom px-4 py-3">
                <span>Tüm Projelerimi Gör</span>
                <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </div>
</section>
